{
  "manifest_version": 3,
  "name": "Manipulation Identifier",
  "version": "1.0",
  "description": "Identifies manipulative language on web pages.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Analyze This Page",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["tactics.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ]
}