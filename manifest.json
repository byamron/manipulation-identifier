{
  "manifest_version": 3,
  "name": "Manipulation Identifier",
  "version": "1.0",
  "description": "Identifies manipulative language on web pages.",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
